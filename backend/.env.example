# Copy this file to backend/.env and fill in your own values.
USE_LOCAL_MODEL=false
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
VLM_MODEL_ID=prithivMLmods/Deepfake-Detect-Siglip2
TEXT_MODEL_ID=fakespot-ai/roberta-base-ai-text-detection-v1
HF_API_URL=https://router.huggingface.co/hf-inference/models/prithivMLmods/Deepfake-Detect-Siglip2
HF_TEXT_API_URL=https://router.huggingface.co/hf-inference/models/fakespot-ai/roberta-base-ai-text-detection-v1
HF_TEXT_API_URL_2=https://router.huggingface.co/hf-inference/models/Hello-SimpleAI/chatgpt-detector-roberta
TEXT_PRIMARY_WEIGHT=0.6
HF_API_TIMEOUT_SECONDS=45
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
LLM_API_URL=https://router.huggingface.co/v1/chat/completions
LLM_MAX_TOKENS=220
LLM_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=100
MAX_TEXT_CHARS=12000
MIN_TEXT_WORDS=80
VIDEO_SAMPLE_FRAMES=4
PDF_SAMPLE_PAGES=3
PDF_EMBEDDED_IMAGE_SAMPLE_LIMIT=4
TEXT_MODEL_CHUNKS=3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
